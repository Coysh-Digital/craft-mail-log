{% extends "_layouts/cp" %}
{% import '_includes/forms.twig' as forms %}

{% set title = "Mail Log"|t('mail-log') %}
{% set crumbs = [] %}

{# Current filters, carried through pagination links #}
{% set filterParams = {search: search, status: status}|filter(v => v is not empty) %}
{% set isFiltered = filterParams is not empty %}

{% block toolbar %}
    <form method="get" action="{{ indexUrl }}" class="flex flex-nowrap" role="search">
        {% for name, value in indexUrlParams %}
            {{ hiddenInput(name, value) }}
        {% endfor %}
        {{ forms.text({
            type: 'search',
            name: 'search',
            value: search,
            placeholder: 'Search subject, sender or recipient'|t('mail-log'),
            inputAttributes: {
                aria: {label: 'Search'|t('mail-log')},
            },
        }) }}
        {{ forms.select({
            name: 'status',
            value: status,
            options: [
                {label: 'All statuses'|t('mail-log'), value: ''},
                {label: 'Sent'|t('mail-log'), value: 'sent'},
                {label: 'Failed'|t('mail-log'), value: 'failed'},
            ],
            inputAttributes: {
                aria: {label: 'Status'|t('mail-log')},
            },
        }) }}
        <button type="submit" class="btn">{{ "Search"|t('mail-log') }}</button>
        {% if isFiltered %}
            <a class="btn" href="{{ cpUrl('mail-log') }}">{{ "Clear"|t('mail-log') }}</a>
        {% endif %}
    </form>

    {% if canDelete and logs|length %}
        <form method="post"
              accept-charset="UTF-8"
              onsubmit="return confirm({{ 'Delete ALL mail log entries? This cannot be undone.'|t('mail-log')|json_encode }});">
            {{ csrfInput() }}
            {{ actionInput('mail-log/logs/flush') }}
            <button type="submit" class="btn">
                {{ "Delete all"|t('mail-log') }}
            </button>
        </form>
    {% endif %}
{% endblock %}

{% block content %}
    {% if logs|length == 0 %}
        <p>
            {% if isFiltered %}
                {{ "No log entries match your search."|t('mail-log') }}
            {% else %}
                {{ "No emails have been logged yet."|t('mail-log') }}
            {% endif %}
        </p>
    {% else %}
        <div class="tableview">
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th scope="col">{{ "Date"|t('mail-log') }}</th>
                        <th scope="col">{{ "Subject"|t('mail-log') }}</th>
                        <th scope="col">{{ "To"|t('mail-log') }}</th>
                        <th scope="col">{{ "From"|t('mail-log') }}</th>
                        <th scope="col">{{ "Status"|t('mail-log') }}</th>
                        {% if canDelete %}
                            <th scope="col"><span class="visually-hidden">{{ "Actions"|t('mail-log') }}</span></th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for log in logs %}
                        {% set subject = log.subject ?: '(no subject)'|t('mail-log') %}
                        <tr>
                            <td>
                                <a href="{{ cpUrl('mail-log/view/' ~ log.id) }}">
                                    {{ log.dateCreated|datetime('short') }}
                                </a>
                            </td>
                            <td>
                                <a href="{{ cpUrl('mail-log/view/' ~ log.id) }}" title="{{ subject }}">
                                    {{ subject|length > 120 ? subject|slice(0, 119) ~ '…' : subject }}
                                </a>
                            </td>
                            <td>
                                {{- (log.toAddresses ?: {})|keys|join(', ') -}}
                            </td>
                            <td>{{ log.fromAddress ?: '' }}</td>
                            <td>
                                {% if log.success %}
                                    <span class="status green" aria-hidden="true"></span>
                                    {{ "Sent"|t('mail-log') }}
                                {% else %}
                                    <span class="status red" aria-hidden="true"></span>
                                    {{ "Failed"|t('mail-log') }}
                                {% endif %}
                            </td>
                            {% if canDelete %}
                                <td class="actions-cell">
                                    <form method="post"
                                          accept-charset="UTF-8"
                                          onsubmit="return confirm({{ 'Delete this log entry?'|t('mail-log')|json_encode }});">
                                        {{ csrfInput() }}
                                        {{ actionInput('mail-log/logs/delete') }}
                                        {{ redirectInput(craft.app.request.absoluteUrl) }}
                                        {{ hiddenInput('id', log.id) }}
                                        <button type="submit"
                                                class="btn small"
                                                aria-label="{{ 'Delete “{subject}”'|t('mail-log', {subject: subject}) }}">
                                            {{ "Delete"|t('mail-log') }}
                                        </button>
                                    </form>
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Pagination — Yii Pagination is 0-indexed internally, 1-indexed in URLs #}
        {% if pagination.pageCount > 1 %}
            <nav class="flex flex-nowrap" aria-label="{{ 'Pagination'|t('mail-log') }}">
                <div class="flex-grow">
                    {{ "Page {current} of {total}"|t('mail-log', { current: pagination.page + 1, total: pagination.pageCount }) }}
                </div>
                <div class="flex flex-nowrap">
                    {% if pagination.page > 0 %}
                        <a class="btn" href="{{ cpUrl('mail-log', filterParams|merge({ page: pagination.page })) }}">
                            ← {{ "Previous"|t('mail-log') }}
                        </a>
                    {% endif %}
                    {% if pagination.page + 1 < pagination.pageCount %}
                        <a class="btn" href="{{ cpUrl('mail-log', filterParams|merge({ page: pagination.page + 2 })) }}">
                            {{ "Next"|t('mail-log') }} →
                        </a>
                    {% endif %}
                </div>
            </nav>
        {% endif %}
    {% endif %}
{% endblock %}
