{
    "name": "coyshdigital/craft-mail-log",
    "description": "Log every email sent via Craft's mailer, regardless of the transport adapter in use.",
    "type": "craft-plugin",
    "license": "MIT",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "email",
        "mail",
        "log",
        "audit",
        "craft-plugin"
    ],
    "authors": [
        {
            "name": "Coysh Digital",
            "homepage": "https://coyshdigital.co.uk"
        }
    ],
    "require": {
        "php": ">=8.2",
        "craftcms/cms": "^5.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "CoyshDigital\\MailLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoyshDigital\\MailLog\\tests\\": "tests/"
        }
    },
    "extra": {
        "name": "Mail Log",
        "handle": "mail-log",
        "developer": "Coysh Digital",
        "developerUrl": "https://coyshdigital.co.uk",
        "class": "CoyshDigital\\MailLog\\MailLog"
    },
    "scripts": {
        "phpstan": "phpstan --memory-limit=1G",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    }
}
